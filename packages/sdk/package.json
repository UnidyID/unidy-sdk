{
  "name": "@unidy.io/sdk",
  "version": "1.12.0",
  "publishConfig": {
    "tag": "latest",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnidyID/unidy-sdk.git",
    "directory": "packages/sdk"
  },
  "description": "Unidy SDK: API Client, Stencil Components, and React Wrappers",
  "homepage": "https://sdk-demo.unidy.io",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "files": [
    "dist/",
    "loader/",
    "readme.md",
    "quick-start-examples.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist www loader .stencil",
    "build": "bun run clean && bun run scripts/generate-version.ts && touch src/demo-build.css && stencil build && bun run build:standalone",
    "build:standalone": "bun build ./src/api/standalone.ts --outdir ./dist/collection/api --format esm && bun run build:standalone:types",
    "build:standalone:types": "tsc -p tsconfig.standalone.json",
    "dev:stencil": "stencil build --dev --watch --serve",
    "dev:css": "tailwindcss -i ./src/demo.css -o ./src/demo-build.css --content './src/**/*.{html}' --watch",
    "dev": "concurrently \"bun run dev:stencil\" \"bun run dev:css\"",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "type": "tsc --noEmit",
    "e2e:configure": "bun run e2e/scripts/configure-e2e.ts",
    "e2e": "playwright test",
    "e2e:ci": "bun run e2e:configure && playwright test --ui",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@sentry/browser": "^11.0.0",
    "@stencil/store": "^2.2.4",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "jwt-decode": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup-plugin-visualizer": "6.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@stencil/core": "^4.45.1",
    "@stencil/react-output-target": "^1.6.2",
    "@tailwindcss/cli": "4.2.2",
    "@tailwindcss/postcss": "4.2.2",
    "@types/bun": "^1.4.2",
    "@types/eventemitter3": "^2.0.4",
    "@types/events": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "baseline-browser-mapping": "^2.11.25",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.3",
    "eventemitter3": "^5.0.4",
    "jest": "^30.5.2",
    "jest-cli": "^30.5.2",
    "puppeteer": "^25.12.0",
    "stencil-tailwind-plugin": "^2.0.6",
    "tailwindcss": "4.2.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "keywords": [
    "web-components",
    "unidy",
    "unidy-sdk",
    "unidy-web-components",
    "newsletter",
    "unidy-newsletter",
    "newsletter-sdk",
    "react",
    "next"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./sdk.css": "./dist/sdk.css",
    "./locales": "./dist/locales",
    "./api": {
      "import": "./dist/api/index.js",
      "require": "./dist/api/index.cjs.js"
    },
    "./auth": {
      "import": "./dist/auth/sdk.esm.js",
      "require": "./dist/auth/sdk.cjs.js"
    },
    "./newsletter": {
      "import": "./dist/newsletter/sdk.esm.js",
      "require": "./dist/newsletter/sdk.cjs.js"
    },
    "./profile": {
      "import": "./dist/profile/sdk.esm.js",
      "require": "./dist/profile/sdk.cjs.js"
    },
    "./shared": {
      "import": "./dist/shared/sdk.esm.js",
      "require": "./dist/shared/sdk.cjs.js"
    },
    "./ticketable": {
      "import": "./dist/ticketable/sdk.esm.js",
      "require": "./dist/ticketable/sdk.cjs.js"
    },
    "./standalone": {
      "import": "./dist/collection/api/standalone.js",
      "types": "./dist/types/api/standalone.d.ts"
    }
  }
}
